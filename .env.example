# DEV PATH V5 — variáveis de ambiente
# Copie para ".env" (desenvolvimento) ou cadastre no painel do provedor de nuvem (produção).
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# --- Desenvolvimento local -------------------------------------------------
# NODE_ENV=development
# PORT=3100
# PUBLIC_BASE_URL=http://localhost:3100

# --- Produção (nuvem, multi-rede) -------------------------------------------
NODE_ENV=production

# A maioria dos provedores define PORT sozinha; só preencha se o seu pedir.
# PORT=3100

# Endereço público, com https:// e sem barra no fim. É a base do QR Code: <PUBLIC_BASE_URL>/join/<código>
# No Render pode ficar sem: o servidor usa o endereço que o Render informa (RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=https://devpath.seudominio.com

# Fuso horário dos horários dos cadastros (servidores de nuvem rodam em UTC)
TZ=America/Sao_Paulo

# Código do evento (vai no endereço da TV: /presentation/FATEC2026/TELAO-01)
EVENT_CODE=FATEC2026

# Telões do evento, separados por vírgula. Cada um tem QR, fila e TV próprios.
DISPLAYS=TELAO-01

# Nome do evento nas métricas (também dá para trocar no painel)
# EVENTO=Feira de Profissões 2026

# PostgreSQL gerenciado (o provedor mostra a "connection string")
DATABASE_URL=postgresql://usuario:senha@host:5432/devpath

# 32+ caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor muda os códigos dos QR Codes (QRs impressos deixam de valer) e desloga o painel.
SESSION_SECRET=troque-por-64-caracteres-aleatorios

# Senha do painel /operador (10+ caracteres; "fatec" não é aceita em produção)
ADMIN_KEY=troque-por-uma-senha-forte

# Atrás do proxy HTTPS do provedor (padrão em produção: 1)
# TRUST_PROXY=1
